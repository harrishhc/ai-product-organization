.DS_Store
Thumbs.db
*.log
.env
.env.local
node_modules/

# Local clones of "git_remote" products (runtime/productSync.js). Each
# product owns its own repository; these are working copies, never checked
# into the PDM repo.
/.product-clones/

# Same for "git_remote" organizations (runtime/organizationContext.js).
/.organization-clones/

# Host-local worker state: per-session settings, and the worktrees the
# concurrent-session rule in AGENTS.md tells workers to create here. A worktree
# is a checkout, not repository content — without this, `git add -A` stages one
# whole, `.git` file and all.
/.claude/

# PDM Core is registered as a product whose repository is this one, so its
# disposable Active Brief (runtime/workState.js) would otherwise appear here as
# an untracked file; other products keep theirs in their own ignored clones.
/products/pdm-core/active-brief.md
